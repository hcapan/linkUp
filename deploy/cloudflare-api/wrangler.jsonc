{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkup-api",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // Not reachable from the internet: only linkup-web calls it via a service binding.
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../../apps/api/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API_CONTAINER", "class_name": "ApiContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],
  "observability": { "enabled": true }
}
