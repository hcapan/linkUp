{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkup-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Only the main workers.dev URL (behind Cloudflare Access) — no unprotected per-version preview URLs.
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "linkup-web" },
    // The API Worker + Container (deploy/cloudflare-api). Deploy that first.
    { "binding": "API", "service": "linkup-api" }
  ],
  "observability": { "enabled": true }
}
