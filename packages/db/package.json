{
  "name": "@linkup/db",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL + pgvector schema (Drizzle), migrations and demo seed",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file=../../.env src/scripts/seed.ts",
    "reset": "tsx --env-file=../../.env src/scripts/reset.ts && pnpm migrate && pnpm seed",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-pgvector": "^0.0.10",
    "@linkup/core": "workspace:*",
    "@linkup/embeddings": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0"
  }
}
