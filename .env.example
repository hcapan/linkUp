# ---- Database (local Podman, see compose.yaml) ----
DATABASE_URL=postgres://linkup:linkup@127.0.0.1:5434/linkup

# ---- API ----
API_PORT=4100
# Shared secret the Webex bot uses to call /bot/* endpoints
BOT_API_KEY=dev-bot-key-change-me

# ---- Web ----
WEB_PORT=5050
API_URL=http://127.0.0.1:4100
WEB_BASE_URL=http://localhost:5050

# ---- Embeddings (superpower bio / growth goal semantic match) ----
# local = on-device MiniLM model via transformers.js (downloaded once from Hugging Face, data never leaves the machine)
# hash  = dependency-free lexical fallback (no model download)
EMBEDDINGS_PROVIDER=local

# ---- Webex bot ----
# Create a bot at https://developer.webex.com/my-apps and paste its access token here.
# The bot runs in WebSocket mode: no public URL / ngrok needed.
WEBEX_BOT_TOKEN=
